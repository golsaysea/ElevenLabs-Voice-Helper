{
  "manifest_version": 3,
  "name": "ElevenLabs 批量工坊 (自动化版)",
  "version": "6.9.0",
  "description": "超大窗口，支持跨 API 账号一键复制/同步音色（兼容免费号）、批量开头标签与智能自动加标签、音频效果、GitHub 自动更新提示。",
  "permissions": [
    "storage",
    "downloads",
    "system.display",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.elevenlabs.io/*",
    "https://elevenlabs.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开批量工坊"
  },
  "icons": {
     "16": "icon.png",
     "48": "icon.png",
     "128": "icon.png"
  }
}
